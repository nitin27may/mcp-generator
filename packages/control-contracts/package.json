{
  "name": "@mcpgen/control-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared request/response schemas and computeGates() for apps/web — the only piece of gating logic that legitimately runs both server- and client-side. Must never import react/next (contracts-pure, boundaries.mjs).",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@mcpgen/domain": "workspace:*",
    "@mcpgen/config-schema": "workspace:*",
    "@mcpgen/readiness-engine": "workspace:*",
    "@mcpgen/risk-engine": "workspace:*",
    "@mcpgen/upstream-auth": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0"
  }
}
