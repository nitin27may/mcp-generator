# Copy to .env and adjust only if you changed a port in docker-compose.yml.
# Every value here is local-only and disposable.

ORDERS_API_URL=http://localhost:8281
MCP_ISSUER_URL=http://localhost:8280/realms/mcpgen
# This server's own public URL. RFC 9728 discovery is derived from it.
# The audience Keycloak actually mints (the client id `mcp-server`) is pinned
# in mcp.config.json, because the two are not the same thing here.
MCP_PUBLIC_URL=http://127.0.0.1:8290/mcp

EXCHANGE_CLIENT_ID=mcp-server
EXCHANGE_CLIENT_SECRET=sandbox-e2e-client-secret-not-a-real-credential
