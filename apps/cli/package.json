{
  "name": "@mcpgen/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The open-source mcpgen CLI: serve, validate, print-tools, print-config, generate. Not the runtime baked into a *generated* package's own dist/cli.mjs (see @mcpgen/generator's bundleRuntime) — this is the tool that produces that package.",
  "main": "./dist/mcpgen.mjs",
  "bin": { "mcpgen": "./dist/mcpgen.mjs" },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@mcpgen/binding-engine": "workspace:*",
    "@mcpgen/config-schema": "workspace:*",
    "@mcpgen/config-seed": "workspace:*",
    "@mcpgen/domain": "workspace:*",
    "@mcpgen/generator": "workspace:*",
    "@mcpgen/mcp-protocol": "workspace:*",
    "@mcpgen/mcp-runtime": "workspace:*",
    "@mcpgen/openapi-adapter": "workspace:*",
    "@mcpgen/redaction": "workspace:*",
    "@mcpgen/risk-engine": "workspace:*",
    "@mcpgen/upstream-auth": "workspace:*",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "0.28.2"
  }
}
