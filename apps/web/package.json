{
  "name": "@mcpgen/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The hosted wizard UI: import an OpenAPI/Swagger spec, configure it, generate a governed MCP server package. Same @mcpgen/* engine the open-source CLI (apps/cli) uses \u2014 no duplicated logic.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "clean": "rm -rf .next .turbo",
    "capture:hero": "node scripts/capture-hero.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@swc/helpers": "0.5.24",
    "@mcpgen/binding-engine": "workspace:*",
    "@mcpgen/config-schema": "workspace:*",
    "@mcpgen/config-seed": "workspace:*",
    "@mcpgen/control-contracts": "workspace:*",
    "@mcpgen/domain": "workspace:*",
    "@mcpgen/generator": "workspace:*",
    "@mcpgen/mcp-runtime": "workspace:*",
    "@mcpgen/openapi-adapter": "workspace:*",
    "@mcpgen/readiness-engine": "workspace:*",
    "@mcpgen/redaction": "workspace:*",
    "@mcpgen/risk-engine": "workspace:*",
    "@mcpgen/schema-normalizer": "workspace:*",
    "@mcpgen/upstream-auth": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "yazl": "^3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mcpgen/test-fixtures": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yazl": "^3.3.1"
  }
}
