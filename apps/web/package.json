    "@mcpgen/readiness-engine": "workspace:*",
    "@mcpgen/risk-engine": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
